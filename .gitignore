# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
.env

# Training outputs
artifacts/
ray_results/
checkpoints/
*.log
*.csv
*.jsonl

# Models and native binaries
*.pkl
*.pkl.gz
*.pt
*.pth
*.ckpt
*.onnx
*.dll
*.lib
*.pdb

# Competition packages and private submission material
Release_submit/
student/my_submission.py
student/submission.py
*.xml
*.pptx
*.zip

# Curated archival exceptions. These are intentionally small, selected artifacts;
# do not broaden these rules to the generated artifacts/ or checkpoint trees.
!evidence/**/*.csv
!evidence/**/*.log
!submission_snapshot/artifacts/
!submission_snapshot/artifacts/models/
!submission_snapshot/artifacts/models/**/
!submission_snapshot/**/*.pkl.gz
!submission_snapshot/**/*.dll
!submission_snapshot/**/*.xml

# Editors and OS
.idea/
.vscode/
.DS_Store
Thumbs.db
